# ============================================================
# Opsera — FormGuard Secrets Placeholder
# Fill in these values in Opsera's Secrets Vault (NOT in git).
# This file is for reference only — never commit real values.
# ============================================================

# ── Opsera Platform ─────────────────────────────────────────
OPSERA_ORG_NAME=                    # Your Opsera org slug (e.g. formguard-org)
OPSERA_PIPELINE_TOKEN=              # API token for Opsera CLI / webhook triggers

# ── GitHub ──────────────────────────────────────────────────
GITHUB_ORG=                         # GitHub org or username (e.g. your-github-username)
GITHUB_TOKEN=                       # GitHub PAT with repo + webhook scope

# ── Computer B — Backend ────────────────────────────────────
INSFORGE_API_URL=https://api.insforge.dev
INSFORGE_API_KEY=                   # Insforge API key (dev key for dev env, prod key for prod)

NEAR_ENDPOINT_DEV=http://127.0.0.1:5001/near     # mock NEAR (Computer C local)
NEAR_ENDPOINT_STAGING=              # Computer C staging URL  e.g. http://<staging-ip>:5001/near
NEAR_ENDPOINT_PROD=                 # Signing relay URL in prod e.g. https://near-relay.formguard.io/near

# ── Computer A — Frontend ────────────────────────────────────
VITE_BACKEND_URL_DEV=http://localhost:8000
VITE_BACKEND_URL_STAGING=           # e.g. https://api-staging.formguard.io
VITE_BACKEND_URL_PROD=              # e.g. https://api.formguard.io

VITE_GEMINI_API_KEY=                # Google Gemini Live API key

# ── Computer C — NEAR ────────────────────────────────────────
NEAR_ACCOUNT_ID=                    # e.g. formguard-testnet.testnet
NEAR_PRIVATE_KEY=                   # ed25519:... funded testnet key
NEAR_CONTRACT_ID=                   # same as NEAR_ACCOUNT_ID unless deployed separately
NEAR_NETWORK=testnet

# ── Notifications ────────────────────────────────────────────
SLACK_WEBHOOK_URL=                  # Slack incoming webhook for #formguard-ops alerts
